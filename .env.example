# ── OpenClaw Gateway ───────────────────────────────────────────────────────────
# Token used to authenticate with the OpenClaw gateway
AUTH_TOKEN=

# OpenRouter model identifier (e.g. openrouter/openai/gpt-4o)
OPENROUTER_MODEL=

# OpenRouter API key
OPENROUTER_API_KEY=

# ── Backend ────────────────────────────────────────────────────────────────────
# Port the NestJS server listens on
PORT=8000

# WebSocket URL of the OpenClaw gateway (used by the backend)
OPENCLAW_WS_URL=ws://openclaw-gateway:18789

# Stable seed for device identity (random key generated if not set)
DEVICE_SECRET=

# ── Frontend ───────────────────────────────────────────────────────────────────
# Base URL of the backend API (used by Vite at build time)
VITE_API_URL=http://localhost:8000
